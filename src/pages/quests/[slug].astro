---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Emblem from '../../components/Emblem.astro';
import { personLd, profile, projects, type Project } from '../../data/resume';

export const getStaticPaths = (() =>
  projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
  next: Project;
}

const { project: p, next } = Astro.props;
const [name, ...tagParts] = p.title.split(': ');
const tag = tagParts.join(': ');
const seed = projects.findIndex((x) => x.slug === p.slug) + 1;
const site = Astro.site!;
const path = `/quests/${p.slug}`;
const url = new URL(path, site).href;
const person = personLd(site);
const jsonLd = [
  {
    '@type': 'CreativeWork',
    '@id': `${url}#work`,
    name: p.title,
    headline: p.title,
    description: p.summary,
    abstract: p.brief,
    url,
    author: { '@id': person['@id'] },
    creator: { '@id': person['@id'] },
    sourceOrganization: { '@type': 'Organization', name: p.company },
    keywords: p.stack.join(', '),
    temporalCoverage: p.period,
    ...(p.image && { image: new URL(p.image, site).href }),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Quests', item: new URL('/#quests', site).href },
      { '@type': 'ListItem', position: 3, name: p.title, item: url },
    ],
  },
  person,
];
---

<Base title={`${p.title} | ${profile.shortName}`} description={p.summary} path={path} ogType="article" jsonLd={jsonLd} quest={p.slug}>
  <article class="qp" data-zone="quests">
    <div class="wrap">
      <nav aria-label="Breadcrumb" class="crumbs">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/#quests">Quests</a></li>
          <li aria-current="page">{p.company}</li>
        </ol>
      </nav>

      <header class="qp-head">
        <div class="qp-intro">
          <h1>
            <span class="name display battered" data-spot>{name}</span>
            {tag && <span class="sr-only">: </span>}
            {tag && <span class="tag display">{tag}</span>}
          </h1>
          <p class="qp-summary">{p.summary}</p>
          <dl class="qp-facts">
            <div><dt class="label">Type</dt><dd>{p.type}</dd></div>
            <div><dt class="label">Role</dt><dd>{p.role}</dd></div>
            <div><dt class="label">Guild</dt><dd>{p.company}</dd></div>
            <div><dt class="label">Period</dt><dd>{p.period}</dd></div>
          </dl>
          {
            p.url && (
              <a class="btn" href={p.url} rel="noopener" target="_blank">
                Visit {p.company} ↗
              </a>
            )
          }
        </div>
        <div class="qp-art panel">
          {
            p.image ? (
              <img src={p.image} alt={`Screenshot of ${p.title}`} width="960" height="540" />
            ) : (
              <Emblem glyph={p.glyph} seed={seed} />
            )
          }
        </div>
      </header>

      <div class="qp-grid">
        <div class="qp-main">
          <section aria-labelledby="brief" data-press>
            <h2 id="brief" class="display">Quest briefing</h2>
            <p>{p.brief}</p>
          </section>
          <section aria-labelledby="objectives" data-press>
            <h2 id="objectives" class="display">Objectives completed</h2>
            <ul class="objectives">{p.built.map((b) => <li>{b}</li>)}</ul>
          </section>
        </div>
        <aside class="qp-side" data-press>
          <div class="panel loot">
            <h2 class="display">Loot: tech stack</h2>
            <ul class="chips">{p.stack.map((s) => <li class="chip">{s}</li>)}</ul>
          </div>
          <a class="panel next" href={`/quests/${next.slug}`}>
            <span class="label">Next quest</span>
            <strong class="display">{next.title.split(': ')[0]}</strong>
          </a>
          <a class="btn btn-primary" href="/#contact">Recruit {profile.shortName.split(' ')[0]} to your party</a>
        </aside>
      </div>
    </div>
  </article>
</Base>

<style>
  .qp {
    padding-block: 28px clamp(64px, 10vw, 112px);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    font-size: 0.9rem;
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 6px;
  }
  .qp-head {
    display: grid;
    gap: 32px;
    align-items: start;
    margin-top: 28px;
  }
  @media (min-width: 960px) {
    .qp-head {
      grid-template-columns: 1.15fr 1fr;
      gap: 48px;
    }
  }
  h1 {
    display: grid;
    gap: 6px;
  }
  .name {
    display: block;
    width: fit-content;
    font-size: clamp(4rem, 2rem + 9vw, 9rem);
    line-height: 0.86;
    color: var(--spot-text);
  }
  .tag {
    font-size: clamp(1.6rem, 1.1rem + 1.8vw, 2.6rem);
    line-height: 1;
  }
  .qp-summary {
    margin-top: 20px;
    font-size: 1.15rem;
    max-width: 56ch;
  }
  .qp-facts {
    display: grid;
    margin: 24px 0;
    max-width: 480px;
    border-bottom: var(--rule);
  }
  .qp-facts div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 8px;
    padding: 9px 0;
    border-top: var(--rule);
  }
  .qp-facts dd {
    margin: 0;
    font-weight: 500;
  }
  .qp-art {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .qp-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.25);
  }
  .qp-grid {
    display: grid;
    gap: 40px;
    margin-top: clamp(48px, 7vw, 88px);
  }
  @media (min-width: 960px) {
    .qp-grid {
      grid-template-columns: 1.6fr 1fr;
      gap: 56px;
      align-items: start;
    }
    .qp-side {
      position: sticky;
      top: calc(var(--hud-h) + 24px);
    }
  }
  .qp-main {
    display: grid;
    gap: 44px;
  }
  .qp-main h2,
  .loot h2 {
    font-size: clamp(2.4rem, 1.8rem + 2vw, 3.4rem);
    margin-bottom: 16px;
  }
  .qp-main p {
    font-size: 1.05rem;
    max-width: 66ch;
  }
  .objectives {
    list-style: none;
    display: grid;
    border-top: var(--rule);
    background: var(--stock);
  }
  .objectives li {
    position: relative;
    padding: 14px 16px 14px 48px;
    border-bottom: var(--rule);
  }
  .objectives li::before {
    content: '';
    position: absolute;
    left: 16px;
    top: 19px;
    width: 14px;
    height: 8px;
    border-left: 3px solid var(--fg);
    border-bottom: 3px solid var(--fg);
    transform: rotate(-45deg);
  }
  .qp-side {
    display: grid;
    gap: 14px;
  }
  .loot {
    padding: 20px;
  }
  .next {
    display: grid;
    gap: 6px;
    padding: 20px;
    text-decoration: none;
  }
  .next strong {
    font-size: 2.4rem;
    line-height: 0.95;
    font-weight: 400;
  }
  .next:hover {
    background: var(--fg);
    color: var(--stock);
  }
</style>
