---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Alwyn Tablatin" description="This page does not exist." path="/404" noindex>
  <section class="lost" data-zone="hero">
    <div class="wrap">
      <p class="code display" data-spot>404</p>
      <h1 class="display">You wandered off the map.</h1>
      <p>This area hasn't been built yet. Head back to the start and pick a quest.</p>
      <a class="btn btn-primary" href="/">Return to spawn point</a>
    </div>
  </section>
</Base>

<style>
  .lost {
    padding-block: clamp(64px, 12vw, 160px);
  }
  .wrap {
    display: grid;
    justify-items: start;
    gap: 20px;
  }
  .code {
    font-size: clamp(8rem, 4rem + 22vw, 20rem);
    line-height: 0.8;
    color: var(--spot-text);
  }
  h1 {
    font-size: clamp(3rem, 1.5rem + 6vw, 7rem);
    line-height: 0.9;
  }
</style>
