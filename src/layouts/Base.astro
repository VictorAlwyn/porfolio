---
import { Font } from 'astro:assets';
import '../styles/global.css';
import HUD from '../components/HUD.astro';
import { profile } from '../data/resume';

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: Record<string, unknown>[];
  ogType?: 'website' | 'article' | 'profile';
  quest?: string;
  noindex?: boolean;
}

const { title, description, path, jsonLd = [], ogType = 'website', quest, noindex = false } = Astro.props;
const site = Astro.site!;
const canonical = new URL(path, site).href;
const ogImage = new URL('/og.png', site).href;
// Escape "<" so JSON content can never close the script tag.
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd }).replace(/</g, '\\u003c');
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#080a14" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Plain-text profile for AI assistants" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${profile.title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-body" preload={[{ weight: '400' }, { weight: '700' }]} />
    <Font cssVariable="--font-pixel" />
    {jsonLd.length > 0 && <script type="application/ld+json" set:html={ld} />}
  </head>
  <body data-quest={quest}>
    <a class="skip-link" href="#main">Skip to content</a>
    <HUD />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>© {year} {profile.name}. Built with Astro, Three.js and GSAP.</p>
        <p class="footer-hint">Psst: old-school cheat codes work here.</p>
      </div>
    </footer>
    <script>
      import '../scripts/hud.ts';
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 28px;
    color: var(--dim);
    font-size: 0.9rem;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
  }
  .footer-hint {
    font-family: var(--font-pixel);
    font-size: 0.6rem;
    line-height: 2;
  }
</style>
