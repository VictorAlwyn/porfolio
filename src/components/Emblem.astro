---
interface Props {
  glyph: string;
  hue: number;
}
const { glyph, hue } = Astro.props;
---

<div class="emblem" style={`--hue:${hue}`} aria-hidden="true">
  <span class="hex"><span>{glyph}</span></span>
</div>

<style>
  .emblem {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(circle at 50% 50%, hsl(var(--hue) 90% 60% / 0.35), transparent 55%),
      repeating-linear-gradient(90deg, hsl(var(--hue) 80% 70% / 0.08) 0 1px, transparent 1px 28px),
      repeating-linear-gradient(0deg, hsl(var(--hue) 80% 70% / 0.08) 0 1px, transparent 1px 28px),
      linear-gradient(135deg, hsl(var(--hue) 55% 16%), hsl(calc(var(--hue) + 50) 50% 9%));
  }
  .hex {
    display: grid;
    place-items: center;
    width: 30%;
    max-width: 120px;
    aspect-ratio: 0.9;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: linear-gradient(160deg, hsl(var(--hue) 95% 72%), hsl(calc(var(--hue) + 40) 85% 50%));
    box-shadow: 0 0 40px hsl(var(--hue) 90% 60%);
  }
  .hex span {
    font-family: var(--font-pixel);
    font-size: clamp(0.8rem, 2.4vw, 1.25rem);
    color: hsl(var(--hue) 60% 10%);
  }
</style>
