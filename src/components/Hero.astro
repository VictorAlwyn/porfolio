---
import { experience, profile } from '../data/resume';

const card = [
  ['XP', '8+ years'],
  ['Guild', experience[0].company],
  ['Realms', 'US · Canada · UK'],
  ['Base', `${profile.location} · Remote`],
];
const specials = ['LLM pipelines', 'AI agents', 'Voice AI', 'Real-time systems', 'SOC 2 security'];
---

<section class="hero" aria-labelledby="hero-title">
  <canvas id="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-floor" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <div class="hero-copy">
      <p class="kicker" data-hero-item style="--i:0">Player 1 · Class: AI Engineer</p>
      <h1 id="hero-title" data-hero-item style="--i:1">
        <span class="hero-name">{profile.name}</span>
        <span class="hero-role">{profile.title}</span>
      </h1>
      <p class="hero-lede" data-hero-item style="--i:2">
        I design and ship LLM workflows, AI agents and voice agents, plus the web and mobile apps around them. 8+ years
        building for teams in the United States, Canada and the United Kingdom.
      </p>
      <div class="hero-cta" data-hero-item style="--i:3">
        <a class="btn btn-primary" href="#quests">Start the quest log <span aria-hidden="true">▶</span></a>
        <a class="btn" href="/resume.pdf" data-xp="resume" download="Alwyn-Tablatin-Resume.pdf">Download resume</a>
      </div>
      <p class="hero-hint" data-hero-item style="--i:4">Explore the map to earn XP and unlock achievements.</p>
    </div>

    <aside class="card panel" aria-label="Character card" data-hero-item style="--i:2">
      <div class="card-top">
        <div class="crest" data-secret aria-hidden="true"><span>{profile.initials}</span></div>
        <div>
          <p class="card-name">{profile.shortName}</p>
          <p class="card-class">{profile.title}</p>
        </div>
      </div>
      <dl class="card-stats">
        {
          card.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
      <p class="card-label">Special moves</p>
      <ul class="chips">{specials.map((s) => <li class="chip">{s}</li>)}</ul>
    </aside>
  </div>
</section>

<script>
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const idle = window.requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 200));
  // WebGL is optional decoration: no WebGL2 or reduced motion means the CSS backdrop stays.
  if (canvas && !calm) {
    idle(() =>
      import('../scripts/hero-scene')
        .then((m) => m.start(canvas))
        .catch(() => {}),
    );
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: min(calc(100svh - var(--hud-h)), 940px);
    padding-block: clamp(40px, 8vw, 96px) clamp(64px, 10vw, 120px);
    overflow: hidden;
  }
  /* Capped at one screen so the constellation stays behind the title on tall mobile heroes. */
  #hero-canvas {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    height: min(100%, 100svh);
    z-index: -1;
    opacity: 0;
    transition: opacity 1.4s ease;
  }
  #hero-canvas.on {
    opacity: 1;
  }
  /* Single-column layout puts text over the scene, so dim it for legibility. */
  @media (max-width: 959px) {
    #hero-canvas.on {
      opacity: 0.5;
    }
  }
  .hero-floor {
    position: absolute;
    inset: auto -20% 0;
    height: 48%;
    z-index: -2;
    background:
      repeating-linear-gradient(90deg, color-mix(in oklab, var(--accent) 28%, transparent) 0 1px, transparent 1px 64px),
      repeating-linear-gradient(0deg, color-mix(in oklab, var(--accent) 22%, transparent) 0 1px, transparent 1px 64px);
    transform: perspective(420px) rotateX(62deg);
    transform-origin: bottom;
    mask-image: linear-gradient(to top, #000 10%, transparent 85%);
    opacity: 0.55;
  }

  .hero-inner {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-inner {
      grid-template-columns: 1.3fr 1fr;
      gap: 56px;
    }
  }

  h1 {
    margin-top: 18px;
    display: grid;
    gap: 10px;
  }
  .hero-name {
    font-size: clamp(2.5rem, 1.4rem + 5.2vw, 5.2rem);
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  .hero-role {
    font-size: clamp(1.25rem, 1rem + 1.4vw, 2rem);
    font-weight: 500;
    background: linear-gradient(90deg, var(--gold), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-lede {
    margin-top: 22px;
    max-width: 56ch;
    color: var(--muted);
    font-size: clamp(1.05rem, 1rem + 0.35vw, 1.2rem);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }
  .hero-hint {
    margin-top: 22px;
    color: var(--dim);
    font-size: 0.9rem;
  }

  .card {
    padding: clamp(20px, 3vw, 28px);
    backdrop-filter: blur(6px);
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--accent) 10%, transparent),
      0 30px 80px -30px color-mix(in oklab, var(--accent) 35%, transparent);
  }
  .card-top {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .crest {
    display: grid;
    place-items: center;
    width: 72px;
    height: 80px;
    flex: none;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: linear-gradient(135deg, var(--gold), var(--accent));
    color: #10121f;
    font-family: var(--font-pixel);
    font-size: 1rem;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.15s var(--ease);
  }
  .crest:active {
    transform: scale(0.92);
  }
  .card-name {
    font-weight: 700;
    font-size: 1.25rem;
  }
  .card-class {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .card-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 22px 0;
  }
  .card-stats div {
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--bg) 55%, transparent);
    min-width: 0;
  }
  .card-stats dt,
  .card-label {
    font-family: var(--font-pixel);
    font-size: 0.55rem;
    color: var(--gold);
    text-transform: uppercase;
  }
  .card-stats dd {
    margin: 6px 0 0;
    font-size: 0.94rem;
    font-weight: 500;
    overflow-wrap: break-word;
  }
  .card-label {
    margin-bottom: 10px;
  }

  [data-hero-item] {
    animation: rise 0.9s var(--ease) both;
    animation-delay: calc(var(--i, 0) * 90ms);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
</style>
