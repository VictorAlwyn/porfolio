---
import { experience, profile, projects } from '../data/resume';
import Relic from './Relic.astro';

const [first, last] = profile.shortName.split(' ');
const facts = [
  ['XP', '8+ years'],
  ['Class', 'AI Engineer'],
  ['Guild', experience[0].company],
  ['Realms', 'US · Canada · UK'],
  ['Base', `${profile.location} · Remote`],
];
const best = projects.filter((p) => p.type === 'Main quest').slice(0, 3);
const chapters = [
  ['about', 'Character bio'],
  ['quests', 'Quest log'],
  ['skills', 'Skill tree'],
  ['campaign', 'Campaign log'],
  ['contact', 'Join the party'],
];
---

<section class="hero" data-zone="hero" aria-labelledby="hero-title">
  <Relic id="hero" at="top:0;right:calc(22% + 8px)" />
  <div class="hero-grid wrap">
    <aside class="rail rail-left" aria-label="Character card">
      <div class="crest" data-secret aria-hidden="true">{profile.portrait ? <img src={profile.portrait} alt="" width="76" height="76" /> : <span>{profile.initials}</span>}</div>
      <dl class="facts">
        {
          facts.map(([k, v]) => (
            <div>
              <dt class="label">{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
      <a class="gh" href={profile.github} data-xp="contact" rel="me noopener" target="_blank">
        GitHub · {profile.githubHandle}
        <svg class="arrow" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" stroke="currentColor" stroke-width="2" fill="none"></path></svg>
      </a>
    </aside>

    <div class="hero-main">
      <h1 id="hero-title" class="title-stack">
        <span class="name name-a display battered">{first}</span>
        <span class="name name-b display battered" data-spot>{last}</span>
        <span class="role display">{profile.title}</span>
      </h1>

      <div class="pitch panel">
        <p>
          I design and ship LLM workflows, AI agents and voice agents, plus the web and mobile apps around them. 8+ years
          building for teams in the United States, Canada and the United Kingdom.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href={`mailto:${profile.email}`} data-xp="contact">
            Email me
            <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none"></path></svg>
          </a>
          <a class="btn" href="/resume.pdf" data-xp="resume" download="Alwyn-Tablatin-Resume.pdf">Resume (PDF)</a>
        </div>
      </div>
    </div>

    <aside class="rail rail-right" aria-labelledby="best-title">
      <h2 id="best-title" class="label">Best work</h2>
      <ol class="best">
        {
          best.map((p, i) => (
            <li>
              <a href={`/quests/${p.slug}`}>
                <span class="best-n display" data-spot>{i + 1}</span>
                <span class="best-t">
                  <span class="display best-title">{p.title.split(': ')[0]}</span>
                  <span class="best-m">{p.summary}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <nav class="toc" aria-labelledby="toc-title">
        <h2 id="toc-title" class="label">In this issue</h2>
        <ol>
          {
            chapters.map(([id, label], i) => (
              <li>
                <a href={`#${id}`}>
                  <span class="toc-n display" aria-hidden="true">{i + 1}</span>
                  {label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <p class="hint">Explore the issue to earn XP, find hidden registration marks and unlock achievements.</p>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(calc(100svh - var(--hud-h)), 960px);
    display: grid;
  }
  .hero-grid {
    display: grid;
    gap: 0;
    padding-inline: 0;
  }
  .hero-main {
    container-type: inline-size;
    display: grid;
    align-content: space-between;
    gap: 28px;
    padding: clamp(20px, 3vw, 40px) var(--gutter) 0;
    order: -1;
  }

  .title-stack {
    display: grid;
    margin: 0;
  }
  .name {
    display: block;
    font-size: clamp(5.5rem, 31cqi, 17rem);
    line-height: 0.86;
    width: fit-content;
  }
  .name-b {
    margin-top: -0.2em;
    margin-left: 0.04em;
    color: var(--spot-text);
  }
  .role {
    margin-top: 14px;
    font-size: clamp(1.5rem, 1rem + 1.8cqi, 2.4rem);
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .pitch {
    max-width: 520px;
    padding: 16px 18px 18px;
    display: grid;
    gap: 14px;
    margin-bottom: clamp(20px, 3vw, 40px);
    font-size: 0.97rem;
    line-height: 1.5;
  }
  @media (max-width: 999px) {
    .pitch {
      background: color-mix(in oklab, var(--stock) 88%, transparent);
    }
    .rail-right {
      order: 0;
    }
    .rail-left {
      order: 1;
    }
    .toc {
      display: none;
    }
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .rail {
    display: grid;
    align-content: start;
    gap: 18px;
    padding: 20px var(--gutter);
    border-top: var(--rule);
    background: var(--stock);
  }
  .crest {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    background: var(--fg);
    color: var(--stock);
    font-family: var(--font-display);
    font-size: 2.6rem;
    line-height: 1;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .crest span {
    padding-top: 6px;
  }
  .crest img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.2);
  }
  .facts {
    display: grid;
  }
  .facts div {
    display: grid;
    gap: 2px;
    padding: 9px 0;
    border-top: var(--rule);
  }
  .facts dd {
    margin: 0;
    font-weight: 500;
  }
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    font-weight: 600;
    padding: 8px 0;
  }

  .best {
    list-style: none;
    display: grid;
  }
  .best li + li {
    border-top: var(--rule);
  }
  .best a {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 14px;
    padding: 14px 0;
    text-decoration: none;
  }
  .best a:hover .best-title {
    text-decoration: underline;
    text-decoration-thickness: 3px;
  }
  .best-n {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    background: var(--spot);
    color: var(--on-spot);
    border: var(--rule);
    font-size: 2.4rem;
    padding-top: 6px;
  }
  .best-t {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .best-title {
    font-size: 1.9rem;
    line-height: 0.95;
  }
  .best-m {
    font-size: 0.86rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .toc {
    display: grid;
    gap: 6px;
    padding-top: 14px;
    border-top: var(--rule);
  }
  .toc ol {
    list-style: none;
    display: grid;
  }
  .toc li + li {
    border-top: var(--rule);
  }
  .toc a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    font-weight: 600;
    text-decoration: none;
  }
  .toc a:hover {
    background: var(--fg);
    color: var(--stock);
  }
  .toc-n {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding-top: 3px;
    background: var(--spot);
    color: var(--on-spot);
    font-size: 1.2rem;
    line-height: 1;
  }
  .hint {
    font-size: 0.86rem;
    border-top: var(--rule);
    padding-top: 12px;
  }

  @media (min-width: 1000px) {
    .hero-grid {
      grid-template-columns: minmax(210px, 17%) 1fr minmax(240px, 22%);
      border-inline: var(--rule);
    }
    .hero-main {
      order: 0;
      padding-top: clamp(24px, 3vw, 44px);
    }
    .rail {
      border-top: 0;
      padding-inline: 20px;
    }
    .rail-left {
      border-right: var(--rule);
    }
    .rail-right {
      border-left: var(--rule);
    }
  }
</style>
