---
import { skills } from '../data/resume';
import Relic from './Relic.astro';

const total = skills.reduce((n, g) => n + g.items.length, 0);
const peak = Math.max(...skills.map((g) => g.items.length));
---

<section class="spread" id="skills" data-section="skills" data-zone="skills" aria-labelledby="skills-title">
  <Relic id="skills" at="top:4px;right:3%" />
  <div class="wrap spread-inner">
    <p class="side-head label" aria-hidden="true"><span>3 · Skill tree</span><span>Chapter three</span></p>
    <div class="spread-body">
      <h2 id="skills-title" class="title" data-press>Unlocked <span class="hot" data-spot>abilities</span></h2>
      <p class="lede" data-press>{total} skills across {skills.length} branches, with AI and LLM engineering as the main build.</p>

      <ul class="index" data-press-group>
        {
          skills.map((g, i) => (
            <li class:list={['row', { primary: i === 0 }]}>
              <div class="head">
                <h3 class="display">{g.name}</h3>
                <p class="label">
                  {g.items.length} unlocked{i === 0 && ' · Main build'}
                </p>
                <span class="level" aria-hidden="true"><span class="fill" data-bar style={`--w:${(g.items.length / peak) * 100}%`}></span></span>
              </div>
              <ul class="chips">
                {g.items.map((s) => (
                  <li class="chip">{s}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hot {
    display: inline-block;
    color: var(--spot-text);
  }
  .index {
    list-style: none;
    margin-top: clamp(28px, 4vw, 52px);
    border-top: var(--rule);
    background: var(--stock);
    border-left: var(--rule);
    border-right: var(--rule);
  }
  .row {
    display: grid;
    gap: 14px 24px;
    padding: 18px clamp(16px, 2vw, 24px);
    border-bottom: var(--rule);
  }
  .head {
    display: grid;
    gap: 4px;
    align-content: start;
  }
  .head h3 {
    font-size: 2.4rem;
    line-height: 0.92;
  }
  .primary {
    background: var(--spot);
    color: var(--on-spot);
  }
  .primary .head h3 {
    font-size: clamp(3rem, 2rem + 4vw, 4.8rem);
  }
  .primary .chip {
    background: transparent;
    border-color: currentColor;
  }
  .level {
    display: block;
    height: 10px;
    margin-top: 6px;
    border: 1px solid currentColor;
  }
  .fill {
    display: block;
    height: 100%;
    width: var(--w);
    background: currentColor;
  }
  @media (min-width: 760px) {
    .row {
      grid-template-columns: minmax(14rem, 28%) 1fr;
      align-items: start;
    }
  }
</style>
