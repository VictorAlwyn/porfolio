---
import Emblem from './Emblem.astro';
import { projects } from '../data/resume';
---

<section class="section" id="quests" data-section="quests" aria-labelledby="quests-title">
  <div class="wrap">
    <div data-reveal>
      <p class="kicker">02 · Quest log</p>
      <h2 class="section-title" id="quests-title">Featured quests</h2>
      <p class="section-intro">
        Products shipped for teams in healthcare, AI SaaS, live entertainment and the web. Open a quest for the full
        story and the stack behind it.
      </p>
    </div>

    <ul class="quest-grid" data-stagger>
      {
        projects.map((p) => (
          <li>
            <article class="quest panel" style={`--hue:${p.hue}`}>
              <div class="quest-art">
                {p.image ? (
                  <img src={p.image} alt={`Screenshot of ${p.title}`} width="640" height="360" loading="lazy" decoding="async" />
                ) : (
                  <Emblem glyph={p.glyph} hue={p.hue} />
                )}
              </div>
              <div class="quest-body">
                <p class="quest-meta">
                  <span class:list={['tag', { main: p.type === 'Main quest' }]}>{p.type}</span>
                  <span>{p.period}</span>
                </p>
                <h3>
                  <a href={`/quests/${p.slug}`}>{p.title}</a>
                </h3>
                <p class="quest-summary">{p.summary}</p>
                <ul class="chips">
                  {p.stack.slice(0, 4).map((s) => (
                    <li class="chip">{s}</li>
                  ))}
                </ul>
                <span class="quest-cta" aria-hidden="true">
                  Accept quest →
                </span>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .quest-grid {
    list-style: none;
    display: grid;
    gap: 20px;
    margin-top: 44px;
  }
  @media (min-width: 640px) {
    .quest-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1040px) {
    .quest-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .quest-grid > li {
    display: grid;
  }
  .quest {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    transition:
      transform 0.3s var(--ease),
      border-color 0.3s,
      box-shadow 0.3s;
  }
  .quest:hover,
  .quest:focus-within {
    transform: translateY(-6px);
    border-color: hsl(var(--hue) 80% 65% / 0.7);
    box-shadow: 0 24px 60px -24px hsl(var(--hue) 90% 55% / 0.55);
  }
  .quest-art {
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .quest-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .quest-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
  }
  .quest-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    color: var(--dim);
    font-size: 0.85rem;
  }
  .tag {
    font-family: var(--font-pixel);
    font-size: 0.55rem;
    line-height: 2;
    color: var(--muted);
  }
  .tag.main {
    color: var(--gold);
  }
  h3 {
    font-size: 1.2rem;
  }
  h3 a {
    text-decoration: none;
  }
  /* Whole card is clickable through the heading link. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  h3 a:focus-visible {
    outline: none;
  }
  .quest:has(h3 a:focus-visible) {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }
  .quest-summary {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .chips {
    margin-top: auto;
  }
  .quest-cta {
    font-weight: 600;
    color: hsl(var(--hue) 90% 72%);
    font-size: 0.92rem;
  }
</style>
