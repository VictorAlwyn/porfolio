---
import Emblem from './Emblem.astro';
import Relic from './Relic.astro';
import { projects, type Project } from '../data/resume';

const [lead, ...rest] = projects;
const mains = rest.filter((p) => p.type === 'Main quest');
const sides = rest.filter((p) => p.type === 'Side quest');
const num = (p: Project) => projects.indexOf(p) + 1;
const split = (p: Project) => {
  const [name, ...tag] = p.title.split(': ');
  return { name, tag: tag.join(': ') };
};
---

<section class="spread" id="quests" data-section="quests" data-zone="quests" aria-labelledby="quests-title">
  <Relic id="quests" at="top:4px;left:46%" />
  <div class="wrap spread-inner">
    <p class="side-head label" aria-hidden="true"><span>2 · Quest log</span><span>Chapter two</span></p>
    <div class="spread-body">
      <h2 id="quests-title" class="title" data-press>Featured <span class="hot" data-spot>quests</span></h2>
      <p class="lede" data-press>
        Products shipped for teams in healthcare, AI SaaS, live entertainment and the web. Open a quest for the full story and the
        stack behind it.
      </p>

      <div class="board" data-press-group>
        {
          [lead, ...mains].map((p) => {
            const { name, tag } = split(p);
            return (
              <article class:list={['cell', 'feature', { lead: p === lead }]}>
                <div class="art">
                  {p.image ? <img src={p.image} alt={`Screenshot of ${p.title}`} width="640" height="360" loading="lazy" decoding="async" /> : <Emblem glyph={p.glyph} seed={num(p)} />}
                </div>
                <div class="copy">
                  <p class="meta label">
                    <span class="num display">{num(p)}</span>
                    <span>{p.type} · {p.period}</span>
                  </p>
                  <h3>
                    <a href={`/quests/${p.slug}`}>
                      <span class="name display">{name}</span><span class="sr-only">: </span>
                      <span class="tag">{tag}</span>
                    </a>
                  </h3>
                  <p class="summary">{p.summary}</p>
                  <ul class="chips">
                    {p.stack.slice(0, 4).map((s) => (
                      <li class="chip">{s}</li>
                    ))}
                  </ul>
                  <span class="cta" aria-hidden="true">
                    Accept quest
                    <svg viewBox="0 0 24 24" width="18" height="18"><path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none"></path></svg>
                  </span>
                </div>
              </article>
            );
          })
        }
        <ul class="sides">
          {
            sides.map((p) => {
              const { name, tag } = split(p);
              return (
                <li class="side cell">
                  <span class="num display" aria-hidden="true">{num(p)}</span>
                  <div class="side-copy">
                    <h3>
                      <a href={`/quests/${p.slug}`}>
                        <span class="name display">{name}</span><span class="sr-only">: </span>
                        <span class="tag">{tag}</span>
                      </a>
                    </h3>
                    <p class="summary">{p.summary}</p>
                  </div>
                  <p class="side-meta label">{p.type} · {p.period}</p>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hot {
    display: inline-block;
    padding: 0 0.12em;
    background: var(--spot);
    color: var(--on-spot);
  }

  .board {
    display: grid;
    margin-top: clamp(28px, 4vw, 52px);
    border-top: var(--rule);
    border-left: var(--rule);
  }
  .cell {
    position: relative;
    border-right: var(--rule);
    border-bottom: var(--rule);
    background: var(--stock);
  }
  .feature {
    display: grid;
    grid-template-rows: auto 1fr;
  }
  .art {
    aspect-ratio: 16 / 9;
    border-bottom: var(--rule);
    overflow: hidden;
  }
  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.25);
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(16px, 2vw, 24px);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .num {
    display: inline-grid;
    place-items: center;
    min-width: 40px;
    height: 40px;
    padding: 5px 6px 0;
    background: var(--spot);
    color: var(--on-spot);
    border: var(--rule);
    font-size: 1.7rem;
    line-height: 1;
  }
  h3 {
    margin: 0;
  }
  h3 a {
    text-decoration: none;
    display: grid;
    gap: 4px;
  }
  /* The whole card is one link, reached through the heading. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  h3 a:focus-visible {
    outline: none;
  }
  .cell:has(h3 a:focus-visible) {
    outline: 3px solid var(--fg);
    outline-offset: -3px;
  }
  .cell:hover .name {
    text-decoration: underline;
    text-decoration-thickness: 4px;
    text-underline-offset: 0.08em;
  }
  .name {
    font-size: clamp(2.4rem, 1.8rem + 2vw, 3.6rem);
    line-height: 0.9;
  }
  .lead .name {
    font-size: clamp(3rem, 2rem + 4vw, 5.6rem);
  }
  .tag {
    font-weight: 600;
  }
  .summary {
    font-size: 0.95rem;
  }
  .chips {
    margin-top: auto;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .sides {
    list-style: none;
    display: grid;
  }
  .side {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 6px 16px;
    align-items: start;
    padding: 16px;
  }
  .side .name {
    font-size: 2rem;
  }
  .side-copy {
    display: grid;
    gap: 6px;
  }
  .side-meta {
    grid-column: 2;
  }

  @media (min-width: 700px) {
    .board {
      grid-template-columns: 1fr 1fr;
    }
    .lead,
    .sides {
      grid-column: 1 / -1;
    }
    .lead {
      grid-template-columns: 1.25fr 1fr;
      grid-template-rows: none;
    }
    .lead .art {
      aspect-ratio: auto;
      min-height: 280px;
      border-bottom: 0;
      border-right: var(--rule);
    }
    .side {
      grid-template-columns: 56px 1fr 11rem;
      align-items: center;
      padding: 18px 20px;
    }
    .side-meta {
      grid-column: auto;
      text-align: right;
    }
  }
</style>
