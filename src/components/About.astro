---
import { profile, stats } from '../data/resume';
import Relic from './Relic.astro';
---

<section class="spread" id="about" data-section="about" data-zone="about" aria-labelledby="about-title">
  <Relic id="about" at="top:4px;right:12%" />
  <div class="wrap spread-inner">
    <p class="side-head label" aria-hidden="true"><span>1 · Character bio</span><span>Chapter one</span></p>
    <div class="spread-body">
      <h2 id="about-title" class="title" data-press>The engineer behind the <span class="hot" data-spot>controller</span></h2>

      <div class="cols">
        <div class="bio panel" data-press>
          {profile.bio.map((p) => <p>{p}</p>)}
        </div>
        <dl class="stats panel" data-press>
          {
            stats.map((s) => (
              <div>
                <dt class="label">{s.label}</dt>
                <dd>
                  <span class="display">{s.value}</span>
                  {s.detail && <span class="detail">{s.detail}</span>}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .hot {
    display: inline-block;
    color: var(--spot-text);
  }
  .cols {
    display: grid;
    margin-top: clamp(28px, 4vw, 56px);
  }
  .bio {
    display: grid;
    gap: 16px;
    padding: clamp(20px, 3vw, 36px);
    max-width: 70ch;
  }
  .bio p:first-child {
    font-size: 1.22em;
    line-height: 1.45;
    font-weight: 500;
  }
  .stats {
    display: grid;
    grid-auto-rows: 1fr;
    margin-top: -1px;
  }
  .stats div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px clamp(16px, 2vw, 24px);
    border-top: var(--rule);
  }
  .stats div:first-child {
    border-top: 0;
  }
  .stats dd {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
    text-align: right;
  }
  .stats .display {
    font-size: 2.6rem;
  }
  .detail {
    font-size: 0.86rem;
  }

  @media (min-width: 960px) {
    .cols {
      grid-template-columns: 1.4fr 1fr;
    }
    .stats {
      margin-top: 0;
      margin-left: -1px;
    }
  }
</style>
