---
import { profile, stats } from '../data/resume';
---

<section class="section" id="about" data-section="about" aria-labelledby="about-title">
  <div class="wrap about">
    <div data-reveal>
      <p class="kicker">01 · Character bio</p>
      <h2 class="section-title" id="about-title">The engineer behind the controller</h2>
      <div class="bio">{profile.bio.map((p) => <p>{p}</p>)}</div>
    </div>
    <ul class="stats" data-stagger>
      {
        stats.map((s) => (
          <li class="stat panel">
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
            {s.detail && <span class="stat-detail">{s.detail}</span>}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .about {
      grid-template-columns: 1.25fr 1fr;
      gap: 72px;
    }
  }
  .bio {
    display: grid;
    gap: 16px;
    margin-top: 22px;
    color: var(--muted);
    max-width: 64ch;
  }
  .bio p:first-child {
    color: var(--text);
    font-size: 1.1em;
  }
  .stats {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .stat {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: clamp(18px, 3vw, 26px);
  }
  .stat-value {
    font-family: var(--font-pixel);
    font-size: clamp(1.4rem, 1rem + 1.6vw, 2.1rem);
    line-height: 1.3;
    color: var(--gold);
    text-shadow: 0 0 24px color-mix(in oklab, var(--gold) 45%, transparent);
  }
  .stat-label {
    font-weight: 600;
  }
  .stat-detail {
    color: var(--dim);
    font-size: 0.88rem;
  }
</style>
