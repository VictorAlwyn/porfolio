---
import { education, experience, type Role } from '../data/resume';
import Relic from './Relic.astro';

const VISIBLE = 2;
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const at = (s: string) => {
  if (s === 'Present') {
    const d = new Date();
    return d.getFullYear() * 12 + d.getMonth();
  }
  const [m, y] = s.split(' ');
  return Number(y) * 12 + MONTHS.indexOf(m);
};
const months = (r: Role) => Math.max(1, at(r.end) - at(r.start) + 1);
const longest = Math.max(...experience.map(months));
const span = (m: number) => `${Math.floor(m / 12) ? `${Math.floor(m / 12)} yr ` : ''}${m % 12 ? `${m % 12} mo` : ''}`.trim();
---

<section class="spread" id="campaign" data-section="campaign" data-zone="campaign" aria-labelledby="campaign-title">
  <Relic id="campaign" at="top:4px;left:68%" />
  <div class="wrap spread-inner">
    <p class="side-head label" aria-hidden="true"><span>4 · Campaign log</span><span>Chapter four</span></p>
    <div class="spread-body">
      <h2 id="campaign-title" class="title" data-press>Work <span class="hot" data-spot>experience</span></h2>
      <p class="lede" data-press>
        Every role is a level. {experience.length} cleared so far, from teaching programming to building AI products. Each bar is the
        time spent there.
      </p>

      <ol class="log">
        {
          experience.map((r, i) => (
            <li class="level" data-months={months(r)}>
              <article>
                <div class="when">
                  <p class="label lv">LV {experience.length - i}</p>
                  <p class="dates">
                    {r.start} – {r.end}
                  </p>
                  <span class="bar" aria-hidden="true"><span class="fill" data-bar style={`--w:${(months(r) / longest) * 100}%`}></span></span>
                  <p class="label">{span(months(r))}</p>
                </div>
                <div class="what">
                  <h3 class="display">{r.role}</h3>
                  <p class="org">
                    <strong>{r.company}</strong> · {r.location}
                  </p>
                  <ul class="bullets">
                    {r.bullets.slice(0, VISIBLE).map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                  {r.bullets.length > VISIBLE && (
                    <details>
                      <summary>Show {r.bullets.length - VISIBLE} more</summary>
                      <ul class="bullets">
                        {r.bullets.slice(VISIBLE).map((b) => (
                          <li>{b}</li>
                        ))}
                      </ul>
                    </details>
                  )}
                  {r.quest && (
                    <a class="level-quest" href={`/quests/${r.quest}`}>
                      View quest →
                    </a>
                  )}
                </div>
              </article>
            </li>
          ))
        }
        <li class="level tutorial">
          <article>
            <div class="when">
              <p class="label lv">Tutorial</p>
              <p class="dates">{education.years}</p>
            </div>
            <div class="what">
              <h3 class="display">{education.degree}</h3>
              <p class="org"><strong>{education.school}</strong> · {education.location}</p>
            </div>
          </article>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .hot {
    display: inline-block;
    background: var(--spot);
    color: var(--on-spot);
    padding: 0 0.12em;
  }
  .log {
    list-style: none;
    margin-top: clamp(28px, 4vw, 52px);
    border-top: var(--rule);
    border-left: var(--rule);
    border-right: var(--rule);
    background: var(--stock);
  }
  .level {
    border-bottom: var(--rule);
  }
  .level article {
    display: grid;
    gap: 14px 28px;
    padding: 18px clamp(16px, 2vw, 24px);
  }
  .when {
    display: grid;
    gap: 6px;
    align-content: start;
  }
  .dates {
    font-weight: 600;
  }
  .bar {
    display: block;
    height: 12px;
    border: 1px solid var(--fg);
  }
  .fill {
    display: block;
    height: 100%;
    width: var(--w);
    background: var(--fg);
  }
  h3 {
    font-size: clamp(1.9rem, 1.5rem + 1.4vw, 2.6rem);
    line-height: 0.95;
  }
  .org {
    margin-top: 6px;
  }
  .bullets {
    display: grid;
    gap: 8px;
    margin-top: 14px;
    padding-left: 20px;
    font-size: 0.95rem;
  }
  details {
    margin-top: 10px;
  }
  summary {
    cursor: pointer;
    font-weight: 700;
    width: fit-content;
    padding: 8px 0;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .level-quest {
    display: inline-block;
    margin-top: 12px;
    padding: 8px 0;
    font-weight: 700;
  }
  .tutorial article {
    border-top: 1px dashed var(--fg);
  }

  @media (min-width: 900px) {
    .level article {
      grid-template-columns: 13rem 1fr;
    }
  }
</style>
